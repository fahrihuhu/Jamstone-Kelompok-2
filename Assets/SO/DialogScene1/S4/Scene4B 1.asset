  sceneId: S4b.1
  sceneDescription: JIKA NILAI UJIAN TINGGI (Benar > 8)
  lines:
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Nilai ujianmu tertinggi seangkatan. Bahkan mengalahkanku. Otak
      encer seperti kamu adalah aset berharga.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 0
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: OSIS bisa memberimu perlindungan resmi dari gangguan Rico maupun
      Gita. Kamu tidak perlu takut lagi dipalak atau diancam di koridor.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 0
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: Syaratnya apa?
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 0
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Pakai kecerdasanmu untuk jadi 'mata-mata' OSIS. Kumpulkan data
      dan bukti pelanggaran dari Faksi Olahraga dan Faksi Kantin. Bantu aku merapikan
      sekolah ini dari dalam.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 0
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: (Aris mau memanfaatkanku untuk mengintai dua faksi lain... Tapi
      kalau aku menolak, aku tidak punya siapa-siapa lagi untuk berlindung.)
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 0
