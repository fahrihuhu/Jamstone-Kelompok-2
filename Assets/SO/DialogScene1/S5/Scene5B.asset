  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Rico kaget melihat Gita datang membawa 2 anak tongkrongan besar
      di belakangnya.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
