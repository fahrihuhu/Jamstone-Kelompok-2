    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Elah, Ric. Malak anak orang sendirian di kelas kosong? Kasihan
      amat kagak ada yang nemenin.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: -6782079960528466537, guid: 76b1a0624390dc246af0ba4d3b09b5d1, type: 3}
