  lines:
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: (Gita! Aku harus minta bantuan Faksi Kantin!)
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: // Tono berlari cepat ke belakang kantin dan menemui Gita. Gita
      langsung memanggil 2 orang temannya yang berbadan besar dari tongkrongan untuk
      mendatangi lokasi bersama Tono. //
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Sprite Tono dan Gita muncul di kiri, Rico muncul di kanan
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Elah, Ric. Malak anak orang sendirian di kelas kosong? Kasihan
      amat kagak ada yang nemenin.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: // Rico kaget melihat Gita datang membawa 2 anak tongkrongan besar
      di belakangnya.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Gita... Lagi-lagi lu ikut campur urusan gua?!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Tono ini sekarang anak gua, Ric. Cabut ga lo! Atau temen gua ini
      yang bakal seret lu keluar dari kelas.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: AHAHAHAH! Lu pikir gua takut cuma gara-gara lu bawa 2 ekor anak
      kantin, Git? Gua udah gedek banget sama lu dari pagi!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Maju lu semua kalau mau mampus di sini!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Sialan... Rico udah hilang akal!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: GUA HABISIN LU SEMUA HARI INI!!
    isThought: 0
    expression: 
