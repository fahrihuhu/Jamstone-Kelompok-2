      expression: marah
      flipX: 0
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Tono ini sekarang anak gua, Ric. Cabut ga lo! Atau temen gua ini
      yang bakal seret lu keluar dari kelas.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
