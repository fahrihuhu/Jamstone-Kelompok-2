    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Gita... Lagi-lagi lu ikut campur urusan gua?!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 0
      character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
