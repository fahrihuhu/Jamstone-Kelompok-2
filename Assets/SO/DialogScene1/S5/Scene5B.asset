  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono berlari cepat ke belakang kantin dan menemui Gita. Gita langsung
      memanggil 2 orang temannya yang berbadan besar dari tongkrongan untuk mendatangi
      lokasi bersama Tono.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 2502215086801707522, guid: 50f28a2eb4bbfb649b058726ca75469d, type: 3}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
