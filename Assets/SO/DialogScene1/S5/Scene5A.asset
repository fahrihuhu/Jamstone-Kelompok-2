      position: 2
      expression: netral
      flipX: 0
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono berbalik arah dan berlari cepat menyusuri koridor utama menuju
      ruang OSIS. Kebetulan, ia melihat Aris sedang berdiri sendirian di depan ruangannya
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 2502215086801707522, guid: 50f28a2eb4bbfb649b058726ca75469d, type: 3}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 0
      character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
      position: 2
      expression: netral
      flipX: 0
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono langsung menghampiri Aris dan melaporkan penganiayaan yang
      sedang dilakukan Rico di ruang kelas mereka.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 0
      character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
      position: 1
      expression: cemas
      flipX: 0
    - action: 0
      character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
      position: 2
      expression: netral
      flipX: 1
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Mendengar laporan itu, Aris tersenyum tipis. Tanpa memanggil anggota
      OSIS lain, ia mengisyaratkan Tono untuk mengikutinya kembali ke kelas.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 1
      character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
      position: 2
      expression: senyum
      flipX: 0
    - action: 1
      character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
      position: 2
      expression: panik
      flipX: 0
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Hentikan aksi murahanmu itu, Rico.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: -8464843772531519362, guid: 96138311690c4f1478b68b65838b7f89, type: 3}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
