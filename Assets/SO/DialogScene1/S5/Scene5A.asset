    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Drap.Drap.Drap
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 2502215086801707522, guid: 50f28a2eb4bbfb649b058726ca75469d, type: 3}
    sfxClip: {fileID: 8300000, guid: 5174a1997528a19439fe942488e4b8aa, type: 3}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
