  m_Script: {fileID: 11500000, guid: ad63281a002ea1e488eed84a1bb6e643, type: 3}
  m_Name: Scene5A
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  sceneId: 5A
  sceneDescription: 
  lines:
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: (Aku harus lapor ke OSIS! Aris sudah berjanji akan menjamin keamananku
      kalau ada pelanggaran!)
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: // Tono berbalik arah dan berlari cepat menyusuri koridor utama
      menuju ruang OSIS. Kebetulan, ia melihat Aris sedang berdiri sendirian di depan
      ruangannya
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono langsung menghampiri Aris dan melaporkan penganiayaan yang
      sedang dilakukan Rico di ruang kelas mereka.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Mendengar laporan itu, Aris tersenyum tipis. Tanpa memanggil anggota
      OSIS lain, ia mengisyaratkan Tono untuk mengikutinya kembali ke kelas. //
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Sprite Aris dan Tono muncul di kiri, Rico dan Radit muncul di kanan.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Hentikan aksi murahanmu itu, Rico.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Hah?! Lu datang sendirian ke sini, Aris? Mau sok jadi pahlawan
      juga lu?!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Hhh..
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Aku memang sendiri di sini, Rico. Tapi ponselku dari tadi menyalakan
      perekam audio yang terhubung langsung ke server OSIS. Jika kau melayangkan
      pukulan lagi... surat sanksi SP2 untukmu resmi terbit sore ini.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: // Bukannya takut, urat-urat di leher dan wajah Rico justru mengeras
      akibat emosi yang membuncah. //
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: SP2...? SP2 kata lu?! GUA KAGAK PEDULI SAMA SURAT SAMPAH LU ITU,
      ARIS!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Gua bakal hancurin muka lu berdua sekalian hari ini, bangsat!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: // Rico mengepalkan tinjunya erat-erat. Tanpa diduga, ia melangkah
      maju penuh amarah menyerang Aris dan Tono. //
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: Kejar
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'Layar mendadak blackout/hitam! SFX: Suara pukulan mentah keras
      (Brakkk!)'
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'Teks Fade In di tengah: TO BE CONTINUED'
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
