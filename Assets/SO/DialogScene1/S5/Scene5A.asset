      character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
      position: 1
      expression: marah
      flipX: 0
    - action: 0
      character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
      position: 0
      expression: cemas
      flipX: 0
    - action: 0
      character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
      position: 2
      expression: marah
      flipX: 1
    - action: 0
      character: {fileID: 11400000, guid: 77df8e0996b6ffe48a13e4e758e35474, type: 2}
      position: 4
      expression: Panik
      flipX: 1
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Hah?! Lu datang sendirian ke sini, Aris? Mau sok jadi pahlawan
      juga lu?!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 0
      character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
      position: 3
      expression: marah
      flipX: 0
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Hhh..
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Aku memang sendiri di sini, Rico. Tapi ponselku dari tadi menyalakan
      perekam audio yang terhubung langsung ke server OSIS. Jika kau melayangkan
      pukulan lagi... surat sanksi SP2 untukmu resmi terbit sore ini.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Bukannya takut, urat-urat di leher dan wajah Rico justru mengeras
      akibat emosi yang membuncah.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: SP2...? SP2 kata lu?! GUA KAGAK PEDULI SAMA SURAT SAMPAH LU ITU,
      ARIS!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Gua bakal hancurin muka lu berdua sekalian hari ini, BANGSAT!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Rico mengepalkan tinjunya erat-erat. Tanpa diduga, ia melangkah
      maju penuh amarah menyerang Aris dan Tono.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
