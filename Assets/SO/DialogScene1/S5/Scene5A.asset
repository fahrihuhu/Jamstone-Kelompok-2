  lines:
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: (Aku harus lapor ke OSIS! Aris sudah berjanji akan menjamin keamananku
      kalau ada pelanggaran!)
    isThought: 1
    expression: 
    backgroundOverride: {fileID: -8464843772531519362, guid: 96138311690c4f1478b68b65838b7f89, type: 3}
