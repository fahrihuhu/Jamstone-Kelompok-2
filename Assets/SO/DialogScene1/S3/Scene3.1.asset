  sceneId: S3.1
  sceneDescription: 
  lines:
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: Makasih ya, Gita.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Lo pikir gua ngelakuin ini tanpa alasan?
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Lagian, orang kayak lo emang harusnya butuh bekingan biar bisa
      selamat disini!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: Terus kamu mau minta apa dari aku?
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: 'Gua beda sama Rico. Gua menawarkan bisnis. '
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: 'Lo tau, selama ini kertas contekan yang kami buat gapernah seluruhnya
      benar.

'
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: 'Tapi kalau ada lo, hal itu bisa berubah!

'
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: Gita
    dialogueText: Lo bantu bikin kunci jawaban dari bocoran soal yang kami curi,
      terus gua jual ke anak-anak lain. Lu dapet bagian keuntungan, plus jaminan
      perlindungan penuh dari teman-teman gua. Gimana?
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices:
    - choiceText: '[ Menerima Tawaran Gita ] (Membantu bisnis sontekan Kantin)'
      nextDialogue: {fileID: 11400000, guid: bd6caa9be3bc0b946b9d6d24650ee6eb, type: 2}
      nextLineIndex: 0
      setFlagKey: gita_bantu
      setFlagValue: bantu
    - choiceText: '[ Menolak Tawaran Gita ] (Menolak terlibat bisnis ilegal)'
      nextDialogue: {fileID: 11400000, guid: 6277d2447824c0e47a558bbbee606665, type: 2}
      nextLineIndex: 0
      setFlagKey: gita_tolak
      setFlagValue: tolak
  fadeTransition: 0
  nextDialogue: {fileID: 0}
  conditionalNexts: []
