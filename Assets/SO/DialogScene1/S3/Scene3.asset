  sceneId: 3
  sceneDescription: 
  lines:
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Background gerbang SMA Garuda, namun tanpa Tono
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'Beberapa minggu berlalu di SMA Garuda. '
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Bagi Tono, setiap hari berjalan seperti meniti tali di atas jurang.
      Ia belajar membaca tanda-tanda bahaya.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'Langkah kaki anak-anak Faksi Olahraga yang menggema di koridor, '
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'aroma asap rokok yang menguar samar dari arah kantin, '
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: hingga tatapan dingin para pengurus OSIS yang mengawasi dari lantai
      atas.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono sebisa mungkin menghindari tempat berbahaya tersebut.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: "Ia menyembunyikan seluruh kecemasannya di balik tumpukan buku
      pelajaran\u2014satu-satunya zona nyaman yang ia kuasai. "
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'Namun, di SMA Garuda, ketenangan selalu berumur pendek. // '
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Background bertransisi ke ruang kelas Tono.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 'SFX: Suara jarum jam dinding berdetak lambat dan nyaring.'
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: // Hari ini adalah Ulangan Harian Pertama.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Walaupun suasana kelas hening, hanya segelintir siswa saja yang
      mengerjakan ulangan harian dengan serius, termasuk Tono dan Radit.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Beberapa siswa juga terlihat menyontek menggunakan kertas contekan.
      Mungkin saja dari faksi Kantin.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Di bangku mejanya, Tono mulai mengerjakan ulangan harian dengan
      seksama. //
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    conditionKey: 
    conditionValue: 
    choices: []
  nextDialogue: {fileID: 0}
