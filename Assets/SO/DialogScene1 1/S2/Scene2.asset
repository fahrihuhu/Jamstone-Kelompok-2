  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono berjalan ke meja pojok belakang. Disitu, duduk seorang anak
      laki-laki berkacamata yang sedang menunduk membaca buku.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: ' Anu.. permisi, disini kosong ya? Boleh aku duduk disini?'
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
